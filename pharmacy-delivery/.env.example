# ============================================================
# PHARMACY DELIVERY API — Environment Configuration
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmacy_delivery
DB_USER=pharmacy_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSL=true

# JWT — use a cryptographically random 256-bit value
JWT_SECRET=CHANGE_ME_256BIT_RANDOM_SECRET
JWT_EXPIRES=8h

# Audit log HMAC (prevents tamper of audit_log integrity_hash)
AUDIT_HMAC_SECRET=CHANGE_ME_SEPARATE_256BIT_SECRET

# Pharmacist digital signature HMAC
PHARMACIST_SIG_SECRET=CHANGE_ME_256BIT_PHARMACIST_SECRET

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=https://pharmacy.yourdomain.ca

# ── Provincial Drug Monitoring Program (PMP) endpoints ───────────────────────
# Obtain credentials from each province's college / health authority
# BC PharmaNet (mandatory for all Rxs in BC)
PMP_BC_ENDPOINT=https://api.pharmanet.gov.bc.ca/v2/dispense
# Ontario (narcotics/targeted substances)
PMP_ON_ENDPOINT=
# Manitoba DPIN
PMP_MB_ENDPOINT=
# Alberta Netcare
PMP_AB_ENDPOINT=
# Nova Scotia
PMP_NS_ENDPOINT=
# Quebec RAMQ
PMP_QC_ENDPOINT=
# Saskatchewan
PMP_SK_ENDPOINT=

# ── Email (prescription ready / delivery notifications) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pharmacy.yourdomain.ca
